NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# Set this to your production app origin, e.g. https://example.com.
# Leave unset for same-origin only.
CORS_ORIGIN=

# Required before exposing admin endpoints.
ADMIN_SECRET=replace-with-a-long-random-secret

# Optional rate limits.
AUTH_RATE_LIMIT_MAX=20
FEEDBACK_RATE_LIMIT_MAX=10
ANALYTICS_RATE_LIMIT_MAX=120

# Optional retention.
AUDIT_LOG_RETENTION_DAYS=30

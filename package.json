{
  "name": "va-cfr-mvp",
  "version": "1.0.0",
  "description": "VA CFR Finder MVP",
  "main": "server.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon server.js",
    "save": "git pull --ff-only && git add . && git diff --cached --quiet || git commit -m \"auto save\" && git push",
    "start": "node server.js",
    "test:e2e:install": "npx playwright install --with-deps",
    "test:e2e": "npx playwright test",
    "smoke:auth": "node scripts/smoke-test-auth.js",
    "smoke:add-task": "node scripts/smoke-test-add-task.js",
    "smoke:all": "npm run smoke:auth && npm run smoke:add-task",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsdom": "^28.1.0",
    "jspdf": "^4.2.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "connect-livereload": "^0.6.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.11"
  }
}
